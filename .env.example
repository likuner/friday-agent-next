APP_ENV=development
# 端口固定 3333：由 package.json 的 `next dev -p 3333` / `next start -p 3333` 决定。
# 注意：Next CLI 不读 .env 里的 PORT（只认进程环境变量 PORT），所以这里不设 PORT。
DATABASE_URL=postgresql://friday:friday@localhost:5433/friday_agent
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# 模型：demo = 本地假流（无 key 开发自测）；deepseek = OpenAI 兼容直连
MODEL_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_THINKING_MODEL=deepseek-v4-pro

# GLM 直连（长期记忆抽取 / 滚动摘要用）
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash

# MCP 工具服务（沿用原 friday-agent 的 mcp-server，勿改其配置）
MCP_SERVER_URL=http://127.0.0.1:8806/mcp
MCP_AUTH_TOKEN=

# 会话级记忆：回放窗口 token 预算与滚动摘要参数
CONTEXT_TOKEN_BUDGET=1000
SUMMARY_MAX_TOKENS=500
SUMMARY_MIN_OVERFLOW_TOKENS=200

# 用户级长期记忆
MEMORY_ENABLED=true
MEMORY_EXTRACT_MIN_MESSAGES=1
MEMORY_MAX_TOKENS=500

# Agent 内置工具（工具在会话固定的工作目录内执行）
AGENT_TOOLS_ENABLED=true
WORKSPACES_DIR=workspaces
